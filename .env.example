# n8n API Configuration
N8N_API_URL=https://awsperth.app.n8n.cloud/api/v1
N8N_API_KEY=your_n8n_api_key_here

# n8n Webhook URLs
NEXT_PUBLIC_N8N_WEBHOOK_BASE=https://awsperth.app.n8n.cloud/webhook
NEXT_PUBLIC_QUEUE_WEBHOOK_PATH=/call-queue-api
NEXT_PUBLIC_SCHEDULED_CALLS_WEBHOOK_PATH=/vapi-scheduled-calls

# Google Sheets API (for leads and bookings data)
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----"

# GoHighLevel CRM API
GHL_API_KEY=your_gohighlevel_api_key_here

# VAPI Voice AI API
VAPI_API_KEY=your_vapi_api_key_here
